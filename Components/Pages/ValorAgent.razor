@page "/declaration"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using main.Services
@inject NavigationManager NavigationManager
@inject DeclarationStore DeclarationStore
@inject AgentStore AgentStore

<PageTitle>Form Value & Agent Declaration</PageTitle>

<div class="declaration-page">

    <img src="images/gs-battery-icon.png" class="watermark" alt="" aria-hidden="true" />

    <div class="declaration-card">

        <div class="declaration-header">
            <button type="button" class="back-btn" @onclick="GoBack" aria-label="Kembali">
                <span class="bi bi-arrow-left"></span>
            </button>
            <h1 class="declaration-title">Form Value &amp; Agent Declaration</h1>
        </div>

        <EditForm Model="@FormModel" OnValidSubmit="HandleSubmit" class="declaration-body">
            <DataAnnotationsValidator />

            <div class="row gx-5 gy-4">

                <!-- Left column -->
                <div class="col-lg-6">

                    <div class="field-group pic-search-group">
                        <label class="field-label">1. Nama PIC <span class="req">*</span></label>
                        <div class="pic-search">
                            <input class="field-input"
                                   placeholder="Ketik nama atau NIM PIC..."
                                   autocomplete="off"
                                   value="@PicSearchText"
                                   @oninput="OnPicSearchInput"
                                   @onfocus="() => ShowPicSuggestions = true"
                                   @onblur="OnPicSearchBlur" />

                            @if (ShowPicSuggestions)
                            {
                                <div class="pic-suggestions">
                                    @if (FilteredPics.Any())
                                    {
                                        @foreach (var pic in FilteredPics)
                                        {
                                            <div class="pic-suggestion" @onmousedown="() => SelectPic(pic)" @onmousedown:preventDefault="true">
                                                <span class="pic-suggestion-id">@pic.Id</span>
                                                <span class="pic-suggestion-name">@pic.Name</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="pic-suggestion pic-suggestion-empty">Tidak ada PIC yang cocok</div>
                                    }
                                </div>
                            }
                        </div>
                        <ValidationMessage For="() => FormModel.PicId" class="field-error" />
                        @if (PicValidationError is not null)
                        {
                            <div class="field-error">@PicValidationError</div>
                        }
                    </div>

                    <div class="field-group">
                        <label class="field-label">2. Department</label>
                        <input class="field-input field-readonly" value="@FormModel.Department" readonly />
                    </div>

                    <div class="field-group">
                        <label class="field-label">3. Safety Declaration <span class="req">*</span></label>
                        <InputTextArea class="field-textarea" rows="7" maxlength="2000"
                                       @bind-Value="FormModel.SafetyDeclaration"
                                       placeholder="Tuliskan safety declaration..." />
                        <ValidationMessage For="() => FormModel.SafetyDeclaration" class="field-error" />
                    </div>

                </div>

                <!-- Right column -->
                <div class="col-lg-6">

                    <div class="field-group">
                        <label class="field-label">4. Lampirkan Dokumen <span class="req">*</span></label>
                        <div class="attach-row">

                            <label class="attach-box @(PhotoPreviewUrl is not null ? "attach-box-filled" : "")">
                                <InputFile class="attach-input" accept="image/*" capture="environment" OnChange="OnPhotoSelected" />
                                @if (IsPhotoProcessing)
                                {
                                    <span class="attach-caption">Memproses...</span>
                                }
                                else if (PhotoPreviewUrl is not null)
                                {
                                    <img src="@PhotoPreviewUrl" class="attach-preview" alt="Pratinjau foto" />
                                    <button type="button" class="attach-remove" @onclick="RemovePhoto" @onclick:preventDefault="true" @onclick:stopPropagation="true" aria-label="Hapus foto">
                                        <span class="bi bi-x-lg"></span>
                                    </button>
                                    <span class="attach-caption attach-caption-overlay text-truncate">@PhotoFileName</span>
                                }
                                else
                                {
                                    <span class="bi bi-camera-fill attach-icon"></span>
                                    <span class="attach-caption">Tap untuk mengambil foto</span>
                                }
                            </label>

                            <label class="attach-box @(VideoPreviewUrl is not null ? "attach-box-filled" : "")">
                                <InputFile class="attach-input" accept="video/*" capture="environment" OnChange="OnVideoSelected" />
                                @if (IsVideoProcessing)
                                {
                                    <span class="attach-caption">Memproses...</span>
                                }
                                else if (VideoPreviewUrl is not null)
                                {
                                    <video src="@VideoPreviewUrl" class="attach-preview" muted playsinline controls></video>
                                    <button type="button" class="attach-remove" @onclick="RemoveVideo" @onclick:preventDefault="true" @onclick:stopPropagation="true" aria-label="Hapus video">
                                        <span class="bi bi-x-lg"></span>
                                    </button>
                                    <span class="attach-caption attach-caption-overlay text-truncate">@VideoFileName</span>
                                }
                                else
                                {
                                    <span class="bi bi-camera-video-fill attach-icon"></span>
                                    <span class="attach-caption">Tap untuk mengambil video</span>
                                }
                            </label>

                        </div>
                        @if (PhotoError is not null)
                        {
                            <div class="field-error">@PhotoError</div>
                        }
                        @if (VideoError is not null)
                        {
                            <div class="field-error">@VideoError</div>
                        }
                        @if (ShowAttachmentError)
                        {
                            <div class="field-error">Lampirkan minimal satu dokumen foto/video</div>
                        }
                    </div>

                    <div class="field-group">
                        <label class="field-label">5. Value Declaration <span class="req">*</span></label>
                        <InputTextArea class="field-textarea" rows="7" maxlength="2000"
                                       @bind-Value="FormModel.ValueDeclaration"
                                       placeholder="Tuliskan value declaration..." />
                        <ValidationMessage For="() => FormModel.ValueDeclaration" class="field-error" />
                    </div>

                </div>

            </div>

            <div class="declaration-actions">
                <button type="button" class="btn-cancel" @onclick="GoBack">Cancel</button>
                <button type="submit" class="btn-submit">Submit</button>
            </div>
        </EditForm>

    </div>
</div>

@code {
    private DeclarationModel FormModel { get; set; } = new();

    // PIC typeahead source, refreshed from AgentStore active theme
    private List<PicRecord> PicOptions { get; set; } = new();

    // Typeahead UI state
    private string PicSearchText = string.Empty;
    private bool ShowPicSuggestions;
    private string? PicValidationError;

    // Attachment state. Preview URLs are base64 data URIs generated client-side
    private string? PhotoFileName;
    private string? VideoFileName;
    private string? PhotoPreviewUrl;
    private string? VideoPreviewUrl;
    private string? PhotoError;
    private string? VideoError;
    private bool IsPhotoProcessing;
    private bool IsVideoProcessing;
    private IBrowserFile? PhotoFile;
    private IBrowserFile? VideoFile;
    private bool ShowAttachmentError;

    /// Suggestions are derived
    private IEnumerable<PicRecord> FilteredPics =>
        string.IsNullOrWhiteSpace(PicSearchText)
            ? PicOptions
            : PicOptions.Where(p =>
                p.Name.Contains(PicSearchText, StringComparison.OrdinalIgnoreCase) ||
                p.Id.Contains(PicSearchText, StringComparison.OrdinalIgnoreCase));

    /// Loads the PICs for the active theme and subscribes to agent changes
    protected override void OnInitialized()
    {
        RefreshPicOptions();
        AgentStore.Changed += OnAgentStoreChanged;
    }

    /// Handles cross-circuit roster changes
    private void OnAgentStoreChanged()
    {
        // Can fire from a different user circuit or thread
        _ = InvokeAsync(() =>
        {
            RefreshPicOptions();
            StateHasChanged();
        });
    }

    private void RefreshPicOptions() => PicOptions = AgentStore.GetCurrentAgents().ToList();

    /// Updates the filter as the user types
    private void OnPicSearchInput(ChangeEventArgs e)
    {
        PicSearchText = e.Value?.ToString() ?? string.Empty;
        ShowPicSuggestions = true;
        PicValidationError = null;
        FormModel.PicId = string.Empty;
        FormModel.Department = string.Empty;
    }

    /// Stores the NIM on the model, copies the department, and formats the input text as "NIM - Name"
    private void SelectPic(PicRecord pic)
    {
        FormModel.PicId = pic.Id;
        FormModel.Department = pic.Department;
        PicSearchText = $"{pic.Id} - {pic.Name}";
        ShowPicSuggestions = false;
        PicValidationError = null;
    }

    private async Task OnPicSearchBlur()
    {
        await Task.Delay(150);
        ShowPicSuggestions = false;
    }

    /// Reads the selected photo into memory, verifies its signature against the expected image formats, and builds a preview data URI
    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        PhotoError = null;
        IsPhotoProcessing = true;
        StateHasChanged();

        try
        {
            const long maxSize = 8 * 1024 * 1024; // 8 MB
            var bytes = await ReadAllBytesAsync(e.File, maxSize);
            var detectedMimeType = DetectImageMimeType(bytes);
            if (detectedMimeType is null)
            {
                PhotoError = "File tidak dikenali sebagai foto yang valid (JPEG/PNG/GIF/WebP)";
                PhotoFile = null;
                PhotoFileName = null;
                PhotoPreviewUrl = null;
                return;
            }

            PhotoPreviewUrl = $"data:{detectedMimeType};base64,{Convert.ToBase64String(bytes)}";
            PhotoFile = e.File;
            PhotoFileName = SanitizeFileName(e.File.Name);
            ShowAttachmentError = false;
        }
        catch (IOException)
        {
            PhotoError = "Ukuran foto terlalu besar (maks 8 MB)";
            PhotoFile = null;
            PhotoFileName = null;
            PhotoPreviewUrl = null;
        }
        finally
        {
            IsPhotoProcessing = false;
        }
    }

    /// Video counterpart of <see cref="OnPhotoSelected"/>. Uses a larger size cap (40 MB) and verifies the container signature before showing a preview
    private async Task OnVideoSelected(InputFileChangeEventArgs e)
    {
        VideoError = null;
        IsVideoProcessing = true;
        StateHasChanged();

        try
        {
            const long maxSize = 40 * 1024 * 1024; // 40 MB
            var bytes = await ReadAllBytesAsync(e.File, maxSize);

            var detectedMimeType = DetectVideoMimeType(bytes);
            if (detectedMimeType is null)
            {
                VideoError = "File tidak dikenali sebagai video yang valid (MP4/WebM/MOV/AVI)";
                VideoFile = null;
                VideoFileName = null;
                VideoPreviewUrl = null;
                return;
            }

            VideoPreviewUrl = $"data:{detectedMimeType};base64,{Convert.ToBase64String(bytes)}";
            VideoFile = e.File;
            VideoFileName = SanitizeFileName(e.File.Name);
            ShowAttachmentError = false;
        }
        catch (IOException)
        {
            VideoError = "Ukuran video terlalu besar (maks 40 MB)";
            VideoFile = null;
            VideoFileName = null;
            VideoPreviewUrl = null;
        }
        finally
        {
            IsVideoProcessing = false;
        }
    }

    private void RemovePhoto()
    {
        PhotoFile = null;
        PhotoFileName = null;
        PhotoPreviewUrl = null;
        PhotoError = null;
    }

    private void RemoveVideo()
    {
        VideoFile = null;
        VideoFileName = null;
        VideoPreviewUrl = null;
        VideoError = null;
    }
    private static async Task<byte[]> ReadAllBytesAsync(IBrowserFile file, long maxSizeBytes)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: maxSizeBytes);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        return memoryStream.ToArray();
    }

    private static string? DetectImageMimeType(byte[] bytes)
    {
        if (bytes.Length >= 3 && bytes[0] == 0xFF && bytes[1] == 0xD8 && bytes[2] == 0xFF)
            return "image/jpeg";

        if (bytes.Length >= 8 && bytes[0] == 0x89 && bytes[1] == 0x50 && bytes[2] == 0x4E && bytes[3] == 0x47
            && bytes[4] == 0x0D && bytes[5] == 0x0A && bytes[6] == 0x1A && bytes[7] == 0x0A)
            return "image/png";

        if (bytes.Length >= 4 && bytes[0] == 'G' && bytes[1] == 'I' && bytes[2] == 'F' && bytes[3] == '8')
            return "image/gif";

        if (bytes.Length >= 12 && bytes[0] == 'R' && bytes[1] == 'I' && bytes[2] == 'F' && bytes[3] == 'F'
            && bytes[8] == 'W' && bytes[9] == 'E' && bytes[10] == 'B' && bytes[11] == 'P')
            return "image/webp";

        return null;
    }

    private static string? DetectVideoMimeType(byte[] bytes)
    {
        // MP4 / MOV: "ftyp" box at byte offset 4.
        if (bytes.Length >= 8 && bytes[4] == 'f' && bytes[5] == 't' && bytes[6] == 'y' && bytes[7] == 'p')
            return "video/mp4";

        // WebM / Matroska EBML header.
        if (bytes.Length >= 4 && bytes[0] == 0x1A && bytes[1] == 0x45 && bytes[2] == 0xDF && bytes[3] == 0xA3)
            return "video/webm";

        // AVI (RIFF....AVI ).
        if (bytes.Length >= 12 && bytes[0] == 'R' && bytes[1] == 'I' && bytes[2] == 'F' && bytes[3] == 'F'
            && bytes[8] == 'A' && bytes[9] == 'V' && bytes[10] == 'I' && bytes[11] == ' ')
            return "video/x-msvideo";

        return null;
    }
    private static string SanitizeFileName(string fileName)
    {
        if (string.IsNullOrWhiteSpace(fileName))
        {
            return "file";
        }

        var name = fileName.Replace('\\', '/').Split('/').Last();
        var builder = new StringBuilder(name.Length);

        foreach (var ch in name)
        {
            if (char.IsControl(ch) || ch is '\u202E' or '\u202D' or '\u200E' or '\u200F')
            {
                continue;
            }

            builder.Append(ch);
        }

        var clean = builder.ToString();
        return clean.Length > 80 ? clean[..77] + "..." : clean;
    }

    private async Task HandleSubmit()
    {
        var pic = PicOptions.FirstOrDefault(p => p.Id == FormModel.PicId);
        if (pic is null)
        {
            PicValidationError = "PIC yang dipilih tidak valid. Silakan pilih ulang dari daftar";
            return;
        }
        FormModel.Department = pic.Department;

        if (PhotoFile is null && VideoFile is null)
        {
            ShowAttachmentError = true;
            return;
        }

        DeclarationStore.Add(new DeclarationRecord(
            PicId: pic.Id,
            PicName: pic.Name,
            Department: pic.Department,
            SafetyDeclaration: FormModel.SafetyDeclaration,
            ValueDeclaration: FormModel.ValueDeclaration,
            PhotoFileName: PhotoFileName,
            VideoFileName: VideoFileName,
            SubmittedAtUtc: DateTime.UtcNow));

        NavigationManager.NavigateTo("/");
    }

    private void GoBack() => NavigationManager.NavigateTo("/");

    /// Unsubscribes from the agent store to release the event handler
    public void Dispose() => AgentStore.Changed -= OnAgentStoreChanged;

    private class DeclarationModel
    {
        [Required(ErrorMessage = "Nama PIC wajib diisi")]
        [StringLength(20, ErrorMessage = "NIM PIC tidak valid")]
        public string PicId { get; set; } = string.Empty;

        [StringLength(120, ErrorMessage = "Department tidak valid")]
        public string Department { get; set; } = string.Empty;

        [Required(ErrorMessage = "Safety Declaration wajib diisi")]
        [StringLength(2000, ErrorMessage = "Safety Declaration maksimal 2000 karakter")]
        public string SafetyDeclaration { get; set; } = string.Empty;

        [Required(ErrorMessage = "Value Declaration wajib diisi")]
        [StringLength(2000, ErrorMessage = "Value Declaration maksimal 2000 karakter")]
        public string ValueDeclaration { get; set; } = string.Empty;
    }

}

<style>
    .declaration-page {
        position: relative;
        min-height: calc(100vh - 6rem);
        display: flex;
        justify-content: center;
        padding: 1.5rem;
        overflow: hidden;
    }

    .watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 30rem;
        height: auto;
        transform: translate(-50%, -50%);
        opacity: .1;
        pointer-events: none;
        user-select: none;
    }

    .declaration-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 62rem;
        border-radius: 1rem;
        box-shadow: 0 12px 34px rgba(20, 20, 20, .1);
        height: fit-content;
    }

    /* Header */
    .declaration-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: #1400f5;
        padding: 1.4rem 1.75rem;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: #fff;
        font-size: 1.3rem;
        line-height: 1;
        padding: 0;
        cursor: pointer;
    }

    .declaration-title {
        flex: 1;
        text-align: center;
        margin: 0;
        /* visually balance the back arrow */
        margin-right: 1.9rem;
        color: #fff;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    /* Body */
    .declaration-body {
        background: #e2e2e2;
        padding: 2rem 1.75rem 1.75rem;
        border-bottom-left-radius: 1rem;
        border-bottom-right-radius: 1rem;
    }

    .field-group {
        margin-bottom: 1.6rem;
    }

    .field-label {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 700;
        font-size: .85rem;
        letter-spacing: .03em;
        text-transform: uppercase;
        color: #1a1a1a;
        margin-bottom: .55rem;
    }

    .req {
        color: #e2222e;
    }

    .field-input,
    .field-textarea {
        width: 100%;
        border: 1px solid #d5d5d5;
        border-radius: .6rem;
        background: #fff;
        padding: .8rem 1rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .85rem;
        color: #1a1a1a;
    }

    .field-input:focus,
    .field-textarea:focus {
        outline: none;
        border-color: #1400f5;
        box-shadow: 0 0 0 3px rgba(20, 0, 245, .12);
    }

    .field-readonly {
        background: #c7c7c7;
        color: #3a3a3a;
        border-color: #c7c7c7;
        cursor: not-allowed;
    }

    .field-textarea {
        resize: vertical;
        min-height: 9.5rem;
        line-height: 1.55;
    }

    .field-error {
        margin-top: .4rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .75rem;
        color: #e2222e;
    }

    /* PIC search / typeahead */
    .pic-search-group {
        position: relative;
    }

    .pic-search {
        position: relative;
    }

    .pic-suggestions {
        position: absolute;
        top: calc(100% + .4rem);
        left: 0;
        right: 0;
        z-index: 20;
        max-height: 14rem;
        overflow-y: auto;
        background: #fff;
        border: 1px solid #d5d5d5;
        border-radius: .6rem;
        box-shadow: 0 10px 24px rgba(20, 20, 20, .12);
    }

    .pic-suggestion {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .65rem 1rem;
        cursor: pointer;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .8rem;
    }

    .pic-suggestion:hover {
        background: #f2f2ff;
    }

    .pic-suggestion-id {
        color: #1400f5;
        font-weight: 700;
    }

    .pic-suggestion-name {
        color: #1a1a1a;
    }

    .pic-suggestion-empty {
        cursor: default;
        color: #8a8a8a;
    }

    .pic-suggestion-empty:hover {
        background: transparent;
    }

    /* Attachments */
    .attach-row {
        display: flex;
        gap: 1rem;
    }

    .attach-box {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        background: #fff;
        border: 1px solid #d5d5d5;
        border-radius: .6rem;
        padding: 1.6rem 1rem;
        cursor: pointer;
        text-align: center;
        transition: border-color .15s ease, background .15s ease;
        overflow: hidden;
        min-height: 8.5rem;
    }

    .attach-box:hover {
        border-color: #1400f5;
        background: #f7f7ff;
    }

    .attach-box-filled {
        padding: 0;
    }

    .attach-preview {
        width: 100%;
        height: 8.5rem;
        object-fit: cover;
        display: block;
        background: #000;
    }

    .attach-remove {
        position: absolute;
        top: .5rem;
        right: .5rem;
        z-index: 2;
        width: 1.7rem;
        height: 1.7rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 50%;
        background: rgba(0, 0, 0, .55);
        color: #fff;
        font-size: .7rem;
        cursor: pointer;
    }

    .attach-remove:hover {
        background: rgba(226, 34, 46, .9);
    }

    .attach-caption-overlay {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: .3rem .6rem;
        background: linear-gradient(0deg, rgba(0, 0, 0, .65), transparent);
        color: #fff;
        text-align: left;
    }

    .attach-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .attach-icon {
        font-size: 1.6rem;
        color: #555;
    }

    .attach-icon-done {
        color: #22a35a;
    }

    .attach-caption {
        max-width: 100%;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .65rem;
        letter-spacing: .03em;
        text-transform: uppercase;
        color: #6b6b6b;
    }

    /* Actions */
    .declaration-actions {
        display: flex;
        justify-content: flex-end;
        gap: .9rem;
        margin-top: .5rem;
    }

    .btn-cancel,
    .btn-submit {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 700;
        font-size: .8rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        padding: .7rem 1.6rem;
        border-radius: .6rem;
        border: 1px solid transparent;
        cursor: pointer;
    }

    .btn-cancel {
        background: #fff;
        border-color: #d5d5d5;
        color: #1a1a1a;
    }

    .btn-cancel:hover {
        background: #f2f2f2;
    }

    .btn-submit {
        background: #4caf6b;
        color: #0a2b16;
    }

    .btn-submit:hover {
        background: #3f9a5c;
    }

    @@media (max-width: 576px) {
        .attach-row {
            flex-direction: column;
        }

        .declaration-title {
            font-size: .95rem;
            margin-right: 1.4rem;
        }
    }
</style>
