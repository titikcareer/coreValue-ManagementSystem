@page "/reset-password"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using main.Services
@inject UserAccountStore UserAccountStore

<PageTitle>Ganti Password</PageTitle>

<div class="reset-page">
    <img src="images/gs-battery-icon.png" class="watermark" alt="" aria-hidden="true" />

    <div class="reset-card">
        <h1 class="reset-title">Ganti Password</h1>
        <p class="reset-sub">Masukkan password Anda saat ini untuk mengatur password baru</p>

        @if (SuccessMessage is not null)
        {
            <div class="reset-success">@SuccessMessage</div>
        }

        <EditForm Model="Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            @if (ErrorMessage is not null)
            {
                <div class="reset-error">@ErrorMessage</div>
            }

            <div class="field-group">
                <label class="field-label">Password Saat Ini</label>
                <InputText class="field-input" type="password" @bind-Value="Model.CurrentPassword" autocomplete="current-password" />
                <ValidationMessage For="() => Model.CurrentPassword" class="field-error" />
            </div>

            <div class="field-group">
                <label class="field-label">Password Baru</label>
                <InputText class="field-input" type="password" @bind-Value="Model.NewPassword" autocomplete="new-password" />
                <ValidationMessage For="() => Model.NewPassword" class="field-error" />
            </div>

            <div class="field-group">
                <label class="field-label">Konfirmasi Password Baru</label>
                <InputText class="field-input" type="password" @bind-Value="Model.ConfirmPassword" autocomplete="new-password" />
                <ValidationMessage For="() => Model.ConfirmPassword" class="field-error" />
            </div>

            <button type="submit" class="btn-submit-full">Simpan Password Baru</button>
        </EditForm>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private ChangePasswordModel Model { get; set; } = new();
    private string? Nim;
    private string? ErrorMessage;
    private string? SuccessMessage;

    /// Captures the NIM from the authenticated principal. Using the server-side
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        Nim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    /// Applies client-side checks
    private void HandleSubmit()
    {
        ErrorMessage = null;
        SuccessMessage = null;

        if (string.IsNullOrEmpty(Nim))
        {
            ErrorMessage = "Sesi tidak valid. Silakan masuk kembali";
            return;
        }

        if (Model.NewPassword != Model.ConfirmPassword)
        {
            ErrorMessage = "Konfirmasi password baru tidak cocok";
            return;
        }

        if (Model.NewPassword == Model.CurrentPassword)
        {
            ErrorMessage = "Password baru harus berbeda dari password saat ini";
            return;
        }

        var success = UserAccountStore.ChangePassword(Nim, Model.CurrentPassword, Model.NewPassword);
        if (!success)
        {
            ErrorMessage = "Password saat ini salah";
            return;
        }

        SuccessMessage = "Password berhasil diperbarui";
        Model = new ChangePasswordModel();
    }

    /// Password change form model and its validation rules
    private class ChangePasswordModel
    {
        [Required(ErrorMessage = "Password saat ini wajib diisi")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password baru wajib diisi.")]
        [MinLength(8, ErrorMessage = "Password baru minimal 8 karakter")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Konfirmasi password baru wajib diisi")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

<style>
    .reset-page {
        position: relative;
        min-height: calc(100vh - 6rem);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        overflow: hidden;
    }

    .watermark {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 30rem;
        height: auto;
        transform: translate(-50%, -50%);
        opacity: .08;
        pointer-events: none;
        user-select: none;
    }

    .reset-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 26rem;
        background: #fff;
        border: 1px solid #ececec;
        border-radius: 1rem;
        box-shadow: 0 12px 34px rgba(20, 20, 20, .1);
        padding: 2.25rem 2rem;
    }

    .reset-title {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: .02em;
        color: #1a1a1a;
        margin-bottom: .3rem;
    }

    .reset-sub {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .75rem;
        color: #8a8a8a;
        margin-bottom: 1.4rem;
    }

    .field-group {
        margin-bottom: 1.2rem;
    }

    .field-label {
        display: block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 700;
        font-size: .75rem;
        letter-spacing: .03em;
        text-transform: uppercase;
        color: #1a1a1a;
        margin-bottom: .4rem;
    }

    .field-input {
        width: 100%;
        border: 1px solid #d5d5d5;
        border-radius: .6rem;
        background: #fff;
        padding: .75rem 1rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .85rem;
        color: #1a1a1a;
    }

    .field-input:focus {
        outline: none;
        border-color: #1400f5;
        box-shadow: 0 0 0 3px rgba(20, 0, 245, .12);
    }

    .field-error {
        margin-top: .35rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .72rem;
        color: #e2222e;
        display: block;
    }

    .reset-error {
        background: #fdecec;
        border: 1px solid rgba(226, 34, 46, .25);
        color: #c21f2c;
        border-radius: .6rem;
        padding: .7rem .9rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .78rem;
        margin-bottom: 1.2rem;
    }

    .reset-success {
        background: #eafaf0;
        border: 1px solid rgba(34, 163, 90, .3);
        color: #1f7a44;
        border-radius: .6rem;
        padding: .7rem .9rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .78rem;
        margin-bottom: 1.2rem;
    }

    .btn-submit-full {
        width: 100%;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 700;
        font-size: .85rem;
        letter-spacing: .03em;
        text-transform: uppercase;
        padding: .8rem;
        border-radius: .6rem;
        border: none;
        background: #1400f5;
        color: #fff;
        cursor: pointer;
        margin-top: .4rem;
    }

    .btn-submit-full:hover {
        background: #1000c4;
    }
</style>
