@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using main.Services
@inject NavigationManager NavigationManager

@* Top navigation bar (Brand, role-filtered links, and the user menu) *@
<header class="topbar">
    <div class="topbar-inner">

        <!-- Brand pill (top-left) -->
        <a class="brand-pill" href="">
            <img src="images/gs-battery-logo.png" alt="PT. GS Battery" class="brand-logo-img" />
        </a>

        <div class="topbar-middle">
            <nav class="topbar-links d-none d-md-flex">
                @foreach (var item in NavItems)
                {
                    <NavLink class="topbar-link" href="@item.Href" Match="item.Match">
                        @item.Label
                    </NavLink>
                }
            </nav>

            <input type="checkbox" title="Navigation menu" class="navbar-toggler d-md-none" />
        </div>

        <!-- User pill (top-right) -->
        <div class="user-menu">
            <input type="checkbox" id="user-menu-toggle" class="user-menu-toggle" />
            <label for="user-menu-toggle" class="user-menu-backdrop" aria-hidden="true"></label>

            <label for="user-menu-toggle" class="user-pill">
                <span class="user-name">@UserName</span>
                <img src="@AvatarUrl" alt="@UserName" class="user-avatar" />
                <span class="bi bi-chevron-down user-caret" aria-hidden="true"></span>
            </label>

            <div class="user-dropdown">
                <a href="/reset-password" class="user-dropdown-item">
                    <span class="bi bi-key-fill" aria-hidden="true"></span> Ganti Password
                </a>
                <a href="/logout" class="user-dropdown-item user-dropdown-item-danger">
                    <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Keluar
                </a>
            </div>
        </div>
    </div>

    <!-- Mobile dropdown -->
    <div class="topbar-mobile d-md-none" onclick="document.querySelector('.navbar-toggler').click()">
        @foreach (var item in NavItems)
        {
            <NavLink class="topbar-mobile-link" href="@item.Href" Match="item.Match">
                <span class="bi @item.Icon" aria-hidden="true"></span> @item.Label
            </NavLink>
        }
    </div>
</header>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // Display state derived from the authenticated principal and role set
    private string UserName { get; set; } = string.Empty;
    private string AvatarUrl { get; set; } = string.Empty;
    private List<NavItemModel> NavItems { get; set; } = new();

    /// Reads the current identity, builds the navigation catalog, and keeps only the entries the user is authorized to see function
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        UserName = user.FindFirst(ClaimTypes.Name)?.Value ?? "Pengguna";
        AvatarUrl = $"https://api.dicebear.com/7.x/avataaars/svg?seed={Uri.EscapeDataString(UserName)}";

        var canSeeDashboard = user.IsInRole(Roles.DashboardAccess);

        var allItems = new List<NavItemModel>
        {
            new("", "Home", "bi-house-door-fill", NavLinkMatch.All, RequiresDashboardAccess: false),
            new("dashboard", "Dashboard", "bi-plus-square-fill", NavLinkMatch.Prefix, RequiresDashboardAccess: true),
            new("agent", "Agent Core Value", "bi-people-fill", NavLinkMatch.Prefix, RequiresDashboardAccess: true),
            new("declaration", "Value & Agent Declaration Portal", "bi-list-nested", NavLinkMatch.Prefix, RequiresDashboardAccess: false),
        };

        NavItems = allItems
            .Where(i => !i.RequiresDashboardAccess || canSeeDashboard)
            .ToList();

        NavigationManager.LocationChanged += OnLocationChanged;
    }

   /// Re-renders on navigation so the active NavLink state and mobile menu reset correctly without a full page reload
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => StateHasChanged();

    /// Detaches the navigation handler to avoid leaks per circuit
    public void Dispose()
        => NavigationManager.LocationChanged -= OnLocationChanged;

    /// One navigation entry, including whether it requires dashboard rights
    private record NavItemModel(string Href, string Label, string Icon, NavLinkMatch Match, bool RequiresDashboardAccess);
}

<style>
    .topbar {
        position: sticky;
        top: 0;
        z-index: 1030;
        background: #fff;
        padding: 1.1rem 1.5rem;
    }

    .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .brand-pill {
        display: inline-flex;
        align-items: center;
        background: #fff;
        border: 1px solid #ececec;
        border-radius: 999px;
        padding: .55rem 1rem;
        box-shadow: 0 2px 8px rgba(20, 20, 20, .06);
        text-decoration: none;
        color: inherit;
    }

    .brand-logo-img {
        height: 1.4rem;
        width: auto;
        display: block;
    }

    .topbar-links {
        gap: 1.75rem;
    }

    .topbar-link {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .8rem;
        font-weight: 600;
        letter-spacing: .03em;
        color: #6b6b6b;
        text-decoration: none;
        padding-bottom: .2rem;
        border-bottom: 2px solid transparent;
        transition: color .15s ease, border-color .15s ease;
    }

    .topbar-link:hover {
        color: #1a1a1a;
    }

    .topbar-link.active {
        color: #e2222e;
        border-color: #e2222e;
    }

    .topbar-middle {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .user-pill {
        display: inline-flex;
        align-items: center;
        gap: .6rem;
        background: #fff;
        border: 1px solid #ececec;
        border-radius: 999px;
        padding: .35rem .35rem .35rem 1rem;
        box-shadow: 0 2px 8px rgba(20, 20, 20, .06);
        cursor: pointer;
        transition: border-color .15s ease;
    }

    .user-name {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-weight: 700;
        font-size: .72rem;
        letter-spacing: .05em;
        color: #1a1a1a;
    }

    .user-avatar {
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 50%;
        object-fit: cover;
        background: #eef3fb;
    }

    .user-menu {
        position: relative;
    }

    .user-menu-toggle {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .user-caret {
        font-size: .65rem;
        color: #8a8a8a;
        margin-right: .5rem;
        transition: transform .15s ease;
    }

    .user-menu-toggle:checked ~ .user-pill .user-caret {
        transform: rotate(180deg);
    }

    .user-menu-toggle:checked ~ .user-pill {
        border-color: #1400f5;
    }

    .user-menu-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1035;
        cursor: default;
    }

    .user-menu-toggle:checked ~ .user-menu-backdrop {
        display: block;
    }

    .user-dropdown {
        display: none;
        flex-direction: column;
        position: absolute;
        top: calc(100% + .5rem);
        right: 0;
        z-index: 1040;
        min-width: 12rem;
        background: #fff;
        border: 1px solid #ececec;
        border-radius: .8rem;
        box-shadow: 0 10px 28px rgba(20, 20, 20, .14);
        padding: .4rem;
        overflow: hidden;
    }

    .user-menu-toggle:checked ~ .user-dropdown {
        display: flex;
    }

    .user-dropdown-item {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .6rem .7rem;
        border-radius: .5rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .78rem;
        font-weight: 600;
        color: #1a1a1a;
        text-decoration: none;
        transition: background-color .15s ease, color .15s ease;
    }

    .user-dropdown-item:hover {
        background: #f2f2ff;
        color: #1400f5;
    }

    .user-dropdown-item-danger:hover {
        background: #fdecec;
        color: #e2222e;
    }

    .navbar-toggler {
        appearance: none;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        border: 1px solid #ececec;
        background: #fff url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(26,26,26,0.8)' stroke-width='2.4' stroke-linecap='round' d='M4 8h22M4 15h22M4 22h22'/%3e%3c/svg%3e") center/1.2rem no-repeat;
        cursor: pointer;
        transition: background-color .15s ease, border-color .15s ease;
    }

    .navbar-toggler:checked {
        background-color: #1400f5;
        border-color: #1400f5;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='white' stroke-width='2.4' stroke-linecap='round' d='M7 7l16 16M23 7L7 23'/%3e%3c/svg%3e");
    }

    .topbar-mobile {
        display: none;
        flex-direction: column;
        gap: .25rem;
        margin-top: 1rem;
        padding: .75rem;
        border-radius: 1rem;
        background: #fafafa;
        border: 1px solid #ececec;
    }

    .topbar:has(.navbar-toggler:checked) .topbar-mobile {
        display: flex;
    }

    .topbar-mobile-link {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: .85rem;
        font-weight: 600;
        color: #444;
        text-decoration: none;
        padding: .6rem .75rem;
        border-radius: .6rem;
    }

    .topbar-mobile-link.active {
        color: #e2222e;
        background: #fdecec;
    }
</style>
